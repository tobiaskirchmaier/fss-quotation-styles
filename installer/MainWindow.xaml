<Window x:Class="FSSStyleInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FSS Zitierstil"
        Width="520"
        Height="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">

    <Grid Margin="32">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="FSS Zitierstil"
                   FontSize="24"
                   FontWeight="SemiBold"/>

        <TextBlock Grid.Row="1"
                   Margin="0,8,0,0"
                   Text="Installation für Microsoft Word"
                   FontSize="14"
                   Foreground="#666666"/>

        <StackPanel Grid.Row="2"
                    VerticalAlignment="Center">

            <TextBlock x:Name="StatusText"
                       Text="Installation wird vorbereitet …"
                       FontSize="14"
                       Margin="0,0,0,12"/>

            <ProgressBar x:Name="ProgressBar"
                         Height="8"
                         Minimum="0"
                         Maximum="100"
                         Value="0"/>

            <TextBlock x:Name="ProgressText"
                       Text="0 %"
                       Margin="0,8,0,0"
                       FontSize="12"
                       Foreground="#666666"/>
        </StackPanel>

        <TextBlock Grid.Row="3"
                   x:Name="TargetText"
                   Text=""
                   FontSize="11"
                   Foreground="#777777"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <Button Grid.Row="4"
                x:Name="CloseButton"
                Content="Schließen"
                Width="100"
                Height="32"
                HorizontalAlignment="Right"
                IsEnabled="False"
                Click="CloseButton_Click"/>

    </Grid>

</Window>