#define IDB_MY_IMAGE 101

IDB_MY_IMAGE BITMAP "banner.bmp"

#include <winver.h>

#define VER_FILEVERSION             1,0
#define VER_FILEVERSION_STR         "1.0\0"

#define VER_PRODUCTVERSION          1,0,1
#define VER_PRODUCTVERSION_STR      "1.0.1\0"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VER_FILEVERSION
PRODUCTVERSION  VER_PRODUCTVERSION

FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0

FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN

BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040704E4"
        BEGIN
            VALUE "CompanyName",      "Tobias Kirchmaier\0"
            VALUE "FileDescription",   "FSS-Zitationsstil Installer\0"
            VALUE "FileVersion",       VER_FILEVERSION_STR
            VALUE "InternalName",      "FSSStyleInstaller\0"
            VALUE "LegalCopyright",    "Copyright (C) 2026 Tobias Kirchmaier\0"
            VALUE "OriginalFilename", "FSSStyleInstaller.exe\0"
            VALUE "ProductName",       "FSS-Zitationsstil\0"
            VALUE "ProductVersion",    VER_PRODUCTVERSION_STR
            VALUE "Comments",          "Installer für den FSS-Zitationsstil\0"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x407, 1252
    END
END